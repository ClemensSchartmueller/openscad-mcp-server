# OpenSCAD executable path. If not set: C:\Program Files\OpenSCAD\openscad.com on Windows;
# `openscad` from PATH on macOS/Linux (falling back to /Applications/OpenSCAD.app on macOS)
# OPENSCAD_PATH=C:\Program Files\OpenSCAD\openscad.com

# Workspace directory where .scad files are read/written (defaults to ~/openscad-workspace)
# OPENSCAD_WORKSPACE=C:\Users\your-username\openscad-workspace

# Timeout in seconds for OpenSCAD rendering processes (defaults to 120)
# OPENSCAD_TIMEOUT=120
